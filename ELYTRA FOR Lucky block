-- SISTEMA DE TROCAR DE ABAS
local function MudarAba(abaAtiva)
    BotoesTP.Visible = (abaAtiva == "TP")
    AreaINFO.Visible = (abaAtiva == "INFO")
    AreaSET.Visible = (abaAtiva == "SET")

    AbaTP.BackgroundColor3 = (abaAtiva == "TP") and Color3.fromRGB(40,40,40) or Color3.fromRGB(25,25,25)
    AbaTP.TextColor3 = (abaAtiva == "TP") and Color3.new(1,1,1) or Color3.new(0.7,0.7,0.7)

    AbaINFO.BackgroundColor3 = (abaAtiva == "INFO") and Color3.fromRGB(40,40,40) or Color3.fromRGB(25,25,25)
    AbaINFO.TextColor3 = (abaAtiva == "INFO") and Color3.new(1,1,1) or Color3.new(0.7,0.7,0.7)

    AbaSET.BackgroundColor3 = (abaAtiva == "SET") and Color3.fromRGB(40,40,40) or Color3.fromRGB(25,25,25)
    AbaSET.TextColor3 = (abaAtiva == "SET") and Color3.new(1,1,1) or Color3.new(0.7,0.7,0.7)
end

AbaTP.MouseButton1Click:Connect(function() MudarAba("TP") end)
AbaINFO.MouseButton1Click:Connect(function() MudarAba("INFO") end)
AbaSET.MouseButton1Click:Connect(function() MudarAba("SET") end)


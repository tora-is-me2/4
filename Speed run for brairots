local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ==============================================
-- NOME DO JOGO
-- ==============================================
local NOME_JOGO = "SPEED RUN FOR BRAIROTS"

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local ToggleBtn = Instance.new("TextButton")
local Check1 = Instance.new("Frame")
local Check2 = Instance.new("Frame")
local Check3 = Instance.new("Frame")
local Check4 = Instance.new("Frame")
local Check5 = Instance.new("Frame")
local Check6 = Instance.new("Frame")
local SpawBtn = Instance.new("TextButton")
local Footer = Instance.new("TextLabel")

-- ==============================================
-- COORDENADAS ORDEM CORRETA + SPAW
-- ==============================================
local Options = {
    ["celestial"] = CFrame.new(120, 30, -29245),
    ["OG"] = CFrame.new(43, 30, -22653),
    ["secreto"] = CFrame.new(60, 30, -16883),
    ["brairotgod"] = CFrame.new(46, 30, -11890),
    ["Mytico"] = CFrame.new(95, 30, -7593),
    ["spaw"] = CFrame.new(86, 30, 136)
}

local CheckFrames = {Check1, Check2, Check3, Check4, Check5, Check6}
local OptionNames = {"celestial", "OG", "secreto", "brairotgod", "Mytico", "spaw"}
local YPos = 42
local menuAberto = true

-- ==============================================
-- TAMANHO MENU 250x260
-- ==============================================
ScreenGui.Name = "MainMenuGui"
ScreenGui.Parent = PlayerGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.ResetOnSpawn = false

MainFrame.Size = UDim2.new(0, 250, 0, 260)
MainFrame.Position = UDim2.new(0.02, 0, 0.05, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
MainFrame.BackgroundTransparency = 0.1
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

-- TITULO
Title.Size = UDim2.new(1, -45, 0, 28)
Title.Position = UDim2.new(0, 10, 0, 6)
Title.BackgroundTransparency = 1
Title.Text = NOME_JOGO
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextScaled = true
Title.Font = Enum.Font.GothamBold
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.Parent = MainFrame

-- BOTAO ABRIR/FECHAR
ToggleBtn.Size = UDim2.new(0, 30, 0, 24)
ToggleBtn.Position = UDim2.new(1, -38, 0, 7)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
ToggleBtn.BorderColor3 = Color3.fromRGB(80, 80, 80)
ToggleBtn.Text = "▼"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.TextScaled = true
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.Parent = MainFrame

-- OPÇÕES DE TP
for i = 1, #OptionNames -1 do
    local opt = Instance.new("TextButton")
    opt.Name = "Option_" .. OptionNames[i]
    opt.Size = UDim2.new(1, -30, 0, 32)
    opt.Position = UDim2.new(0, 10, 0, YPos)
    opt.BackgroundTransparency = 1
    opt.Text = OptionNames[i]
    opt.TextColor3 = Color3.fromRGB(255, 255, 255)
    opt.TextScaled = true
    opt.Font = Enum.Font.GothamMedium
    opt.TextXAlignment = Enum.TextXAlignment.Left
    opt.Parent = MainFrame

    local cb = CheckFrames[i]
    cb.Size = UDim2.new(0, 22, 0, 22)
    cb.Position = UDim2.new(1, -32, 0, 5)
    cb.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    cb.BorderColor3 = Color3.fromRGB(80, 80, 80)
    cb.Parent = MainFrame

    opt.MouseButton1Click:Connect(function()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        
        for _, c in pairs(CheckFrames) do
            c.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        end
        cb.BackgroundColor3 = Color3.fromRGB(80, 150, 255)

        hrp.CFrame = Options[OptionNames[i]]
        ReplicatedStorage.SpawnEvent:FireServer()
    end)

    YPos = YPos + 38
end

-- ==============================
-- BOTAO SPAW ESTILO DA IMAGEM
-- ==============================
SpawBtn.Size = UDim2.new(1, -15, 0, 38)
SpawBtn.Position = UDim2.new(0, 8, 0, YPos + 6)
SpawBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
SpawBtn.BorderSizePixel = 0
SpawBtn.Text = "spaw"
SpawBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SpawBtn.TextScaled = true
SpawBtn.Font = Enum.Font.GothamBold
SpawBtn.TextXAlignment = Enum.TextXAlignment.Center
SpawBtn.Parent = MainFrame

SpawBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    hrp.CFrame = CFrame.new(86, 30, 136)
    ReplicatedStorage.SpawnEvent:FireServer()
end)

-- RODAPÉ
Footer.Size = UDim2.new(1, 0, 0, 20)
Footer.Position = UDim2.new(0, 10, 0, YPos + 52)
Footer.BackgroundTransparency = 1
Footer.Text = "YouTube: Luan script"
Footer.TextColor3 = Color3.fromRGB(200, 200, 200)
Footer.TextScaled = true
Footer.Font = Enum.Font.Gotham
Footer.TextXAlignment = Enum.TextXAlignment.Left
Footer.Parent = MainFrame

-- FUNÇÃO ABRIR/FECHAR
local function AtualizarMenu()
    MainFrame.Size = menuAberto and UDim2.new(0, 250, 0, 260) or UDim2.new(0, 250, 0, 40)
    ToggleBtn.Text = menuAberto and "▼" or "▶"
    
    for _, v in pairs(MainFrame:GetChildren()) do
        local ehItem = v:IsA("TextButton") or v:IsA("Frame") or v == Footer
        v.Visible = menuAberto and ehItem or (v == Title or v == ToggleBtn)
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    menuAberto = not menuAberto
    AtualizarMenu()
end)

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Insert then
        menuAberto = not menuAberto
        AtualizarMenu()
    end
end)

AtualizarMenu()
print("✅ PRONTO! Spaw no final, estilo da imagem e coordenada correta.")
